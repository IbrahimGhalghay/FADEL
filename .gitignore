#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase config (regenerate with `flutterfire configure`)
android/app/google-services.json

# Firebase Admin SDK service account key (for tool/create_business.js — never commit)
tool/serviceAccountKey.json
tool/node_modules/

# Release signing — NEVER commit. Back these up somewhere safe; losing the
# keystore means you can't ship in-place updates to installed devices.
android/key.properties
android/fadel-release-key.jks

# Gradle problem reports land here despite the relocated build dir
android/build/
